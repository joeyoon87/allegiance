# The Worker doesn't read a .env file at runtime — this documents what to
# set, not something the code loads directly.
#
# LOCAL DEV: copy this to `.dev.vars` (gitignored, auto-loaded by
# `wrangler dev`) and fill in real values.
# DEPLOYED: set each one with `wrangler secret put <NAME>` instead —
# never put real secrets in wrangler.jsonc or commit them anywhere.

# Required. Any random 32+ byte string — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=

# Optional. Without it, /distance returns a clear "not configured" error
# and the estimator falls back to manual mile entry — same behavior as
# before, just served from here now instead of a Next.js API route.
GOOGLE_MAPS_API_KEY=

# Optional, all three required together. Without them, the MediRoutes
# client runs in mock mode (src/mediroutes/mock-client.ts) — every
# facility portal feature works against clearly-labeled fake data. Get
# these from your MediRoutes account rep; see CLAUDE.md "MediRoutes
# integration" for what's confirmed vs. still unverified.
MEDIROUTES_API_BASE_URL=
MEDIROUTES_CLIENT_ID=
MEDIROUTES_CLIENT_SECRET=
