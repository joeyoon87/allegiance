{
  "name": "allegiance-portal-worker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:local:init": "wrangler d1 execute allegiance_portal --local --file=./schema.sql",
    "db:local:seed": "wrangler d1 execute allegiance_portal --local --file=./seed.sql",
    "db:remote:init": "wrangler d1 execute allegiance_portal --remote --file=./schema.sql",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.6.14",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261011.1",
    "typescript": "^5",
    "wrangler": "^4.149.0"
  }
}
