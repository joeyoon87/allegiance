# Copy this file to .env.local and fill in real values. .env.local is
# gitignored by default (see .gitignore) and must never be committed.

# Required for address-to-address mileage calculation on /estimate
# (src/lib/distance/google.ts). Create a Google Cloud project, enable the
# "Distance Matrix API", and restrict the key to your server. Without this
# set, the estimator falls back to manual mile entry rather than guessing.
GOOGLE_MAPS_API_KEY=

# --- Facility Portal (prisma/schema.prisma, src/auth.ts) ---

# Local Postgres for development. Create a dedicated, low-privilege role
# and database first (see businesses/allegiance/projects/website-rebuild/
# CLAUDE.md "Local setup" for the exact commands) rather than using the
# postgres superuser here.
DATABASE_URL="postgresql://allegiance_portal:REPLACE_ME@localhost:5432/allegiance_portal_dev"

# Session signing secret. Generate with: npx auth secret
AUTH_SECRET=
