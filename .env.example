# Copy this file to .env.local and fill in real values. .env.local is
# gitignored by default (see .gitignore) and must never be committed.
#
# This is a static site — the only thing it needs at build time is where
# the separate Worker API lives (see /worker, deployed independently).
# Secrets (GOOGLE_MAPS_API_KEY, SESSION_SECRET, MEDIROUTES_*) live in the
# Worker, not here — see worker/.env.example and worker/CLAUDE.md.

NEXT_PUBLIC_API_BASE_URL=http://localhost:8787
