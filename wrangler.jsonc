{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "allegiance-website",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-10",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Deploying the marketing site only for now. The /portal routes ship in
  // this same build (same Next.js app) but have no DATABASE_URL set here,
  // so they render but can't actually authenticate yet — see CLAUDE.md
  // "Facility Portal" status before pointing real traffic at /portal.
  "vars": {}
}
